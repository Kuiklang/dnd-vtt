# Copy to .env and adjust.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vtt
PORT=3001
# Public origin of the web app (used for CORS/Origin checks and invite links)
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set to true behind HTTPS so cookies are marked Secure
COOKIE_SECURE=false
# Where uploaded maps/tokens are stored (local disk backend)
UPLOAD_DIR=./data/uploads
# Character-sheet import from PDF/photo. Choose who reads the sheet:
#   claude-code = Claude Code installed and logged in on THIS computer (uses your Claude plan, no API bill)
#   api         = Claude API with ANTHROPIC_API_KEY below (paid per use)
#   auto        = api if a key is set, otherwise off      off = disabled (the UI says so)
SHEET_READER=auto
# Only for claude-code: full path to the `claude` command if it isn't on PATH, and an optional model
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=
# Only for api/auto. The key stays on the server and is never sent to browsers.
ANTHROPIC_API_KEY=
IMPORT_MODEL=claude-opus-5-5
# Max sheet reads per user per hour
IMPORT_PER_HOUR=10
