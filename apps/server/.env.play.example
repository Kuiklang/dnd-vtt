# Settings for "play at home" (start-windows.bat / pnpm play). Copied to .env by setup.
# The database is built in (saved in the data folder), so there's no DATABASE_URL to set here.

# Port for the website: http://localhost:3001
PORT=3001

# AI features (DM assistant, reading character sheets from PDF/photo):
#   claude-code = Claude Code installed and logged in on THIS computer (free with your Claude plan)
#   off         = turned off (the website says so)
AI_PROVIDER=claude-code
# Full path to the claude command, only if it isn't found automatically
CLAUDE_CODE_PATH=claude
# AI questions per hour for the DM
AI_PER_HOUR=30

# Voice chat: leave empty for the free default. Add a TURN server only if a friend can't connect.
VOICE_ICE_SERVERS=
